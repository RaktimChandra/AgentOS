# Application
APP_NAME=AgentOS
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OPA Policy Engine
OPA_URL=http://localhost:8181
OPA_POLICY_PATH=agentos/auth

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentos-api

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Budget Defaults
DEFAULT_TOKEN_BUDGET=100000
DEFAULT_API_CALL_BUDGET=1000
DEFAULT_COST_BUDGET=100.0
DEFAULT_TIME_BUDGET_SECONDS=300

# Execution
DEFAULT_EXECUTION_TIMEOUT=300
MAX_EXECUTION_TIMEOUT=3600
MAX_DELEGATION_DEPTH=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Storage
REPLAY_STORAGE_PATH=./data/replays
TRACE_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=2555
